# Copy this file to .env and replace placeholder values with your actual secrets.
# -----------------------------------------------------
# IMPORTANT: Never commit your .env file to version control.
# The .gitignore file prevents this automatically.
# -----------------------------------------------------

# Connection string for Azure IoT Hub with iothubowner policy
IOTHUB_CONNECTION_STRING="HostName=<your-hub>.azure-devices.net;SharedAccessKeyName=iothubowner;SharedAccessKey=<your-shared-access-key>"

# Optional: if other tools/scripts need them
AZURE_IOT_HUB_CONNECTION_STRING="HostName=<your-hub>.azure-devices.net;SharedAccessKeyName=iothubowner;SharedAccessKey=<your-shared-access-key>"
AZURE_IOT_HUB_HOSTNAME=<your-hub>.azure-devices.net

# API key for Groq LLM services (if needed by other scripts)
GROQ_API_KEY="<your-groq-api-key>"